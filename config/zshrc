# >>> 顶部交互 guard <<<
if [[ $- != *i* ]]; then
    return
fi
# XDG fallback保护
: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_CACHE_HOME:=$HOME/.cache}"
: "${XDG_DATA_HOME:=$HOME/.local/share}"
: "${XDG_STATE_HOME:=$HOME/.local/state}"

# 终端编辑方式
# -e: emac | -v: vim
bindkey -e

# =========================================
# >>> 🌈 Zinit 终端zsh主题
# =========================================

# >>> Zinit INSTALLATION (官方方案) <<<
ZINIT_HOME="${XDG_DATA_HOME}/zinit/zinit.git"
# 核对 zinit 父目录的存在
if [[ ! -d "${ZINIT_HOME}" ]]; then
    mkdir -p "$(dirname "${ZINIT_HOME}")" #dirname 表示文件父目录存在
fi
# 首次加载拉取仓库 (若不存在则拉取仓库并创建)
if [[ ! -d "${ZINIT_HOME}/.git" ]]; then
    git clone https://github.com/zdharma-continuum/zinit.git "${ZINIT_HOME}"
fi
# 始终加载zinit
source "${ZINIT_HOME}/zinit.zsh"

# cache用于加速补全
ZSH_CACHE="${XDG_CACHE_HOME}/zsh/zcompcache"
if [[ ! -d "${ZSH_CACHE}" ]]; then
    mkdir -p "${ZSH_CACHE}"
fi

zstyle ':completion:*' cache-path "${ZSH_CACHE}"   #补全缓存
zstyle ':completion:*' menu select                 #补全便捷菜单
zstyle ':compinstall' filename "${ZDOTDIR}/.zshrc" #初始化补全系统,推荐定位到.zshrc

# =========================================
# >>> fpath
# fpath 是zsh专用,放在.zshrc(PATH放在.zprofile)
# fpath 要放在 compinit 之前, 执行函数放在 compinit 之后
# =========================================
# 创建 zfunc目录来存放未来的补全工具(备用)
if [[ -d "${XDG_DATA_HOME}/zfunc" ]]; then
    fpath+=("${XDG_DATA_HOME}/zfunc")
fi
# homebrew 自动补全, 将homebrew的zsh/site-functions加入fpath(官方步骤)
if command -v brew >/dev/null 2>&1; then
    eval "$(brew shellenv)"
else
    echo "[zshrc警告] 找不到 brew/homebrew"
fi

# =========================================
# >>> 初始化 compinit 自动补全
# =========================================
autoload -Uz compinit
compinit

# zinit 插件放在compint之后
zinit ice pick'async.zsh' src'pure.zsh' # ice 在 light 之前
zinit light sindresorhus/pure
zinit light zsh-users/zsh-syntax-highlighting
zinit light hlissner/zsh-autopair

# =========================================
# >>> 自动补全插件
# =========================================

# >>> uv completions
if command -v uv >/dev/null 2>&1; then
    eval "$(uv generate-shell-completion zsh)"
else
    echo "[zshrc警告] 找不到 uv"
fi

# >>> ty completions
if command -v ty >/dev/null 2>&1; then
    eval "$(ty generate-shell-completion zsh)"
else
    echo "[zshrc警告] 找不到 ty"
fi

# >>> comfy-cli completion
if command -v comfy >/dev/null 2>&1; then
    eval "$(comfy --show-completion zsh)"
else
    echo "[zshrc警告] 找不到 comfy-cli"
fi

# >>> bun completions
if [[ -s "${BUN_INSTALL}/_bun" ]]; then
    source "${BUN_INSTALL}/_bun"
else
    echo "[zshrc警告] 找不到 _bun"
fi

