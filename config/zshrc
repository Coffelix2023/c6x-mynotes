brew_up() {
    echo "进行每日检查..."
    brew outdated
    echo "🤗过期包检查完毕, 准备更新brew主程序..."
    brew update
    echo "🤗 brew主程序更新完毕, 准备更新包和依赖..."
    brew upgrade
    echo "🤗 brew包依赖更新完毕, 准备清理..."
    brew cleanup
    brew autoremove
    echo "🔰 brew清理完毕, 准备健康检测..."
    brew doctor
    echo "准备清理缓存 (pnpm | npm)..."
    pnpm store prune
    npm cache verify
    echo "🔰 今日检查完毕, Have Fun Everyday~"
}

