# ▶️ 扫描目录中的md文件是否包含敏感信息(screte/api-key/...)
grep_key() {
    grep -rnE "(api[_-]?key|secret|password|token|sk-|pk-|AKIA)" \
        --include="*.md" \
        "$@"
}

# ▶️ 快捷find -print/-delete
fd_prt() {
    find . -maxdepth "$1" -name "$2" -print
}
fd_del() {
    find . -maxdepth "$1" -name "$2" -delete
}

