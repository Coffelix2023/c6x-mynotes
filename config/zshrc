# >>> Python
# =========================================
uv_pip() {
    uv run python -m pip "$@"
}

uv_index() {
    echo "[c6x] uv run python -m pip index versions ..."
    uv run python -m pip index versions "$@"
}

uv_install() {
    echo "[c6x] uv run python -m pip install ..."
    uv run python -m pip install "$@"
}

alias flake7="flake8 --ignore E265,E231,E302,E251,F403,F405"
flake+() {
    autoflake "$@"
    autoflake --remove-all-unused-imports -i "$@"
    isort "$@"
}

